<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppNueva.PaginaChat"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- ENCABEZADO SUPERIOR -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Padding="15,10" ColumnSpacing="12" VerticalOptions="Center">

            <!-- Botón de regreso / Atrás con el vector SVG de Figma -->
            <Path Grid.Column="0" 
                  Data="M9.27415 12.0006L16.2842 4.99053C16.4795 4.79527 16.4795 4.47868 16.2842 4.28342L15.7185 3.71774C15.5232 3.52247 15.2067 3.52247 15.0114 3.71774L7.08212 11.647C6.88685 11.8423 6.88685 12.1589 7.08212 12.3541L15.0114 20.2834C15.2067 20.4787 15.5232 20.4787 15.7185 20.2834L16.2842 19.7177C16.4795 19.5225 16.4795 19.2059 16.2842 19.0106L9.27415 12.0006Z" 
                  Fill="Black" 
                  WidthRequest="24" 
                  HeightRequest="24" 
                  Aspect="Uniform"
                  VerticalOptions="Center" 
                  HorizontalOptions="Center">
                <Path.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnVolverClicked"/>
                </Path.GestureRecognizers>
            </Path>

            <!-- Foto de Perfil Redonda -->
            <Border Grid.Column="1" StrokeShape="RoundRectangle 20" WidthRequest="40" HeightRequest="40" Stroke="Transparent" HorizontalOptions="Center" VerticalOptions="Center">
                <Image Source="dotnet_bot.png" Aspect="AspectFill"/>
            </Border>

            <!-- Nombre del Contacto -->
            <Label Grid.Column="2" Text="Maria Gonzalez" FontSize="16" FontAttributes="Bold" TextColor="Black" VerticalOptions="Center"/>

            <!-- Iconos de Acción (Llamada y Video) -->
            <Path Grid.Column="3" 
          Data="M22 16.92V19.92C22.0011 20.1985 21.9441 20.4742 21.8325 20.7293C21.7209 20.9845 21.5573 21.2136 21.3521 21.4019C21.1468 21.5901 20.9046 21.7335 20.6407 21.8227C20.3769 21.9119 20.0974 21.9451 19.82 21.92C16.7428 21.5856 13.787 20.5341 11.19 18.85C8.77382 17.3147 6.72533 15.2662 5.18999 12.85C3.49997 10.2412 2.44824 7.27099 2.11999 4.18C2.095 3.90346 2.12787 3.62476 2.21649 3.36162C2.30512 3.09849 2.44756 2.85669 2.63476 2.65162C2.82196 2.44655 3.0498 2.28271 3.30379 2.17052C3.55777 2.05833 3.83233 2.00026 4.10999 2H7.10999C7.5953 1.99522 8.06579 2.16708 8.43376 2.48353C8.80173 2.79998 9.04207 3.23944 9.10999 3.72C9.23662 4.68006 9.47144 5.62272 9.80999 6.53C9.94454 6.88792 9.97366 7.27691 9.8939 7.65088C9.81415 8.02484 9.62886 8.36811 9.35999 8.64L8.08999 9.91C9.51355 12.4135 11.5864 14.4864 14.09 15.91L15.36 14.64C15.6319 14.3711 15.9751 14.1858 16.3491 14.1061C16.7231 14.0263 17.1121 14.0555 17.47 14.19C18.3773 14.5285 19.3199 14.7634 20.28 14.89C20.7658 14.9585 21.2094 15.2032 21.5265 15.5775C21.8437 15.9518 22.0122 16.4296 22 16.92Z" 
          Stroke="Black" 
          StrokeThickness="1.8" 
          StrokeLineCap="Round" 
          StrokeLineJoin="Round" 
          WidthRequest="22" 
          HeightRequest="22" 
          Aspect="Uniform" 
          Margin="0,0,8,0" 
          VerticalOptions="Center"/>

            <Path Grid.Column="4" 
      Data="M23 7L16 12L23 17V7Z M14 5H3C1.89543 5 1 5.89543 1 7V17C1 18.1046 1.89543 19 3 19H14C15.1046 19 16 18.1046 16 17V7C16 5.89543 15.1046 5 14 5Z" 
      Stroke="Black" 
      StrokeThickness="1.8" 
      StrokeLineCap="Round" 
      StrokeLineJoin="Round" 
      WidthRequest="22" 
      HeightRequest="22" 
      Aspect="Uniform" 
      VerticalOptions="Center"/>
        </Grid>

        <!-- Separador abajo del encabezado -->
        <BoxView Grid.Row="0" HeightRequest="1" Color="#E5E5E5" VerticalOptions="End"/>

        <!-- 2. ÁREA CENTRAL DEL CHAT -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="15" Spacing="10" VerticalOptions="FillAndExpand">
                <!-- Área reservada sin mensajes -->
            </VerticalStackLayout>
        </ScrollView>

        <!-- Barra de texto e iconos -->
        <Border Grid.Row="2" Margin="15,10" Stroke="#E0E0E0" StrokeShape="RoundRectangle 10" Padding="10,5" BackgroundColor="White">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <!-- Caja de texto -->
                <Entry Grid.Column="0" Placeholder="Mensaje..." PlaceholderColor="#AAAAAA" TextColor="Black" BackgroundColor="Transparent"/>

                <!-- Iconos -->
                <!-- 1. Icono de Micrófono -->
                <Path Grid.Column="1" 
              Data="M12 1C11.2044 1 10.4413 1.31607 9.87868 1.87868C9.31607 2.44129 9 3.20435 9 4V12C9 12.7956 9.31607 13.5587 9.87868 14.1213C10.4413 14.6839 11.2044 15 12 15C12.7956 15 13.5587 14.6839 14.1213 14.1213C14.6839 13.5587 15 12.7956 15 12V4C15 3.20435 14.6839 2.44129 14.1213 1.87868C13.5587 1.31607 12.7956 1 12 1Z M19 10V12C19 13.8565 18.2625 15.637 16.9497 16.9497C15.637 18.2625 13.8565 19 12 19C10.1435 19 8.36301 18.2625 7.05025 16.9497C5.7375 15.637 5 13.8565 5 12V10 M12 19V23 M8 23H16" 
              Stroke="#828282" 
              StrokeThickness="1.8" 
              StrokeLineCap="Round" 
              StrokeLineJoin="Round" 
              WidthRequest="20" 
              HeightRequest="20" 
              Aspect="Uniform" 
              VerticalOptions="Center"/>

                <!-- 2. Icono de Emoji -->
                <Path Grid.Column="2" 
              Data="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z M8 14C8 14 9.5 16 12 16C14.5 16 16 14 16 14 M9 9H9.01 M15 9H15.01" 
              Stroke="#828282" 
              StrokeThickness="1.8" 
              StrokeLineCap="Round" 
              StrokeLineJoin="Round" 
              WidthRequest="20" 
              HeightRequest="20" 
              Aspect="Uniform" 
              VerticalOptions="Center"/>

                <!-- 3. Icono de Imagen / Galería -->
                <Path Grid.Column="3" 
              Data="M19 3H5C3.89543 3 3 3.89543 3 5V19C3 20.1046 3.89543 21 5 21H19C20.1046 21 21 20.1046 21 19V5C21 3.89543 20.1046 3 19 3Z M8.5 10C9.32843 10 10 9.32843 10 8.5C10 7.67157 9.32843 7 8.5 7C7.67157 7 7 7.67157 7 8.5C7 9.32843 7.67157 10 8.5 10Z M21 15L16 10L5 21" 
              Stroke="#828282" 
              StrokeThickness="1.8" 
              StrokeLineCap="Round" 
              StrokeLineJoin="Round" 
              WidthRequest="20" 
              HeightRequest="20" 
              Aspect="Uniform" 
              VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Barra de navegación -->
        <Border Grid.Row="3" BackgroundColor="White" Stroke="#E0E0E0" StrokeShape="Rectangle" Padding="0,8">
            <Grid ColumnDefinitions="*,*,*,*,*">
                <!-- Catálogo -->
                <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="2">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnIrACatalogoClicked"/>
                    </VerticalStackLayout.GestureRecognizers>
                    <Label Text="🏠" FontSize="16" HorizontalOptions="Center"/>
                    <Label Text="Catálogo" FontSize="9" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Chat -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                    <Border BackgroundColor="#EAEAEA" StrokeShape="RoundRectangle 12" Padding="12,2">
                        <Label Text="💬" FontSize="16" HorizontalOptions="Center"/>
                    </Border>
                    <Label Text="Chat" FontSize="9" TextColor="Black" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Seguimiento -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                    <Label Text="📍" FontSize="16" HorizontalOptions="Center"/>
                    <Label Text="Seguimiento" FontSize="9" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Pedidos -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2">
                    <Label Text="🛍️" FontSize="16" HorizontalOptions="Center"/>
                    <Label Text="Pedidos" FontSize="9" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Cuenta -->
                <VerticalStackLayout Grid.Column="4" HorizontalOptions="Center" Spacing="2">
                    <Label Text="👤" FontSize="16" HorizontalOptions="Center"/>
                    <Label Text="Cuenta" FontSize="9" TextColor="Gray" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>