<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppNueva.LoginCliente"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="12" HorizontalOptions="Fill">
            <!-- Logo e Introducción -->
            <Image Source="logowhite.jpg" HeightRequest="120" HorizontalOptions="Center" />

            <!-- Título -->
            <Label Text="Crea una cuenta" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
            <Label Text="Ingresa tu correo electrónico&#10;para registrarte en esta aplicación" 
                   HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="#555555" FontSize="13"/>

            <!-- Formulario -->
            <Entry x:Name="txtCorreo" Placeholder="correoelectrónico@dominio.com" Keyboard="Email" TextColor="Black" HeightRequest="45"/>
            <Entry x:Name="txtContraseña" Placeholder="contraseña" IsPassword="True" TextColor="Black" HeightRequest="45"/>

            <Button Text="Continuar" Clicked="ContinuarClienteClicked" BackgroundColor="#1E1E1E" TextColor="White" CornerRadius="8" HeightRequest="45"/>

            <!-- Separador -->
            <Grid ColumnDefinitions="*,Auto,*" Margin="0,10">
                <BoxView HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center"/>
                <Label Grid.Column="1" Text="o" Margin="10,0" TextColor="Gray" FontSize="12"/>
                <BoxView Grid.Column="2" HeightRequest="1" Color="#E0E0E0" VerticalOptions="Center"/>
            </Grid>

            <!-- Botones Sociales -->
            <Button Text="  Continuar con Google" Clicked="OnContinuarGoogleClicked" ImageSource="logogoggle.png" BackgroundColor="#EEEEEE" TextColor="Black" CornerRadius="8" HeightRequest="45"/>
            <Button Text="  Continuar con Apple" Clicked="OnContinuarAppleClicked" ImageSource="logoapple.png" BackgroundColor="#EEEEEE" TextColor="Black" CornerRadius="8" HeightRequest="45"/>

            <!-- Legales -->
            <Label Text="Al hacer clic en continuar, aceptas nuestros Términos de servicio y Política de privacidad" 
                   FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center" Margin="0,15,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>