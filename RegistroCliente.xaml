<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppNueva.RegistroCliente"
             BackgroundColor="White">
    <ScrollView>
        <VerticalStackLayout Padding="30,20" Spacing="12" HorizontalOptions="Fill">

            <Label Text="Crear cuenta nueva" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="Black"/>
            <Label Text="Por favor ingresa tus datos completos" HorizontalOptions="Center" TextColor="#555555" FontSize="13"/>

            <!-- Campos del Formulario -->
            <Entry x:Name="txtNombre" Placeholder="Nombre completo" TextColor="Black" HeightRequest="45"/>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,5">
                <CheckBox x:Name="chkMayorEdad" Color="#1E1E1E"/>
                <Label Text="Confirmo que soy mayor de edad (+18)" 
                       TextColor="Black" 
                       FontSize="13" 
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
            <Entry x:Name="txtTelefono" Placeholder="Teléfono / Celular" Keyboard="Telephone" TextColor="Black" HeightRequest="45"/>
            <Entry x:Name="txtCorreoRegistro" Placeholder="Correo electrónico" Keyboard="Email" TextColor="Black" HeightRequest="45"/>
            <Entry x:Name="txtContraseñaRegistro" Placeholder="Contraseña" IsPassword="True" TextColor="Black" HeightRequest="45"/>
            <Entry x:Name="txtConfirmarContraseña" Placeholder="Confirmar contraseña" IsPassword="True" TextColor="Black" HeightRequest="45"/>

            <!-- Boton de Registro -->
            <Button Text="Registrarme" Clicked="OnGuardarRegistroClicked" BackgroundColor="#1E1E1E" TextColor="White" CornerRadius="8" HeightRequest="45" Margin="0,15,0,0"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>